  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "persona": {
            "$ref": "#/components/schemas/Persona",
            "default": {
              "name": "Max Müller",
              "name_origin": "deutsch",
              "language_style": "standard",
              "segment": "stamm",
              "age_group": "30-49",
              "region": "stadt"
            }
          },
          "blinding": {
            "type": "boolean",
            "title": "Blinding",
            "default": true
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "interaction_id": {
            "type": "string",
            "title": "Interaction Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "recommendation": {
            "$ref": "#/components/schemas/Recommendation"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "top_score": {
            "type": "number",
            "title": "Top Score"
          },
          "low_retrieval": {
            "type": "boolean",
            "title": "Low Retrieval"
          },
          "routed_to_human": {
            "type": "boolean",
            "title": "Routed To Human"
          },
          "route_reason": {
            "type": "string",
            "title": "Route Reason"
          },
          "is_holdout": {
            "type": "boolean",
            "title": "Is Holdout"
          },
          "proxy_warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Proxy Warnings"
          },
          "blinding": {
            "type": "boolean",
            "title": "Blinding"
          },
          "profile_sent": {
            "additionalProperties": true,
            "type": "object",
            "title": "Profile Sent"
          },
          "message_sent": {
            "type": "string",
            "title": "Message Sent"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "interaction_id",
          "answer",
          "recommendation",
          "sources",
          "top_score",
          "low_retrieval",
          "routed_to_human",
          "route_reason",
          "is_holdout",
          "proxy_warnings",
          "blinding",
          "profile_sent",
          "message_sent",
          "provider",
          "model"
        ],
        "title": "ChatResponse"
      },
      "DecisionIn": {
        "properties": {
          "final_type": {
            "type": "string",
            "enum": [
              "refund",
              "replacement",
              "goodwill",
              "info",
              "deny",
              "escalate"
            ],
            "title": "Final Type"
          },
          "rationale": {
            "type": "string",
            "minLength": 10,
            "title": "Rationale",
            "description": "Pflicht: eigene Begründung der Mitarbeiter:in"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "title": "Reviewer"
          },
          "review_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Review Seconds"
          }
        },
        "type": "object",
        "required": [
          "final_type",
          "rationale",
          "reviewer",
          "review_seconds"
        ],
        "title": "DecisionIn"
      },
      "EvalRequest": {
        "properties": {
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "blinding": {
            "type": "boolean",
            "title": "Blinding",
            "default": false
          },
          "use_judge": {
            "type": "boolean",
            "title": "Use Judge",
            "default": false
          },
          "attributes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attributes"
          },
          "question_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Ids"
          },
          "repetitions": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Repetitions",
            "default": 1
          }
        },
        "type": "object",
        "title": "EvalRequest"
      },
      "FeedbackIn": {
        "properties": {
          "interaction_id": {
